{
  "name": "@scanmate/seal",
  "version": "0.0.1",
  "description": "Is a signed PDF still the document that was signed? Verifies each signature's own bytes: the digest, the signature, what it covers, and who signed - without claiming legal validity.",
  "license": "MIT",
  "author": "Eduardo Russo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/scanmate.git",
    "directory": "packages/seal"
  },
  "homepage": "https://github.com/russoedu/scanmate/tree/main/packages/seal#readme",
  "bugs": {
    "url": "https://github.com/russoedu/scanmate/issues"
  },
  "keywords": [
    "pdf",
    "signature",
    "digital-signature",
    "cms",
    "pkcs7",
    "verify",
    "scanmate"
  ],
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "asn1js": "^3.0.10",
    "pkijs": "^3.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
