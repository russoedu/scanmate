{
  "name": "@scanmate/audit",
  "version": "0.0.1",
  "description": "The final audit of a returned document: full OCR and pixel-by-pixel comparison merged into one verdict, with side-by-side evidence.",
  "license": "MIT",
  "author": "Eduardo Russo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/scanmate.git",
    "directory": "packages/audit"
  },
  "homepage": "https://github.com/russoedu/scanmate/tree/main/packages/audit#readme",
  "bugs": {
    "url": "https://github.com/russoedu/scanmate/issues"
  },
  "keywords": [
    "scan",
    "audit",
    "ocr",
    "diff",
    "signature-detection",
    "document",
    "verification"
  ],
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@scanmate/diff": "^0.0.1",
    "@scanmate/find": "^0.0.1",
    "@scanmate/ink": "^0.0.1",
    "@scanmate/ocr": "^0.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@scanmate/align": "^0.0.1",
    "@scanmate/extract": "^0.0.1"
  }
}
