{
  "name": "@scanmate/find",
  "version": "0.0.1",
  "description": "Is required content on each page of a scan, and where the original prints it? Approximate search with figures held exact.",
  "license": "MIT",
  "author": "Eduardo Russo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/scanmate.git",
    "directory": "packages/find"
  },
  "homepage": "https://github.com/russoedu/scanmate/tree/main/packages/find#readme",
  "bugs": {
    "url": "https://github.com/russoedu/scanmate/issues"
  },
  "keywords": [
    "scan",
    "ocr",
    "search",
    "fuzzy-search",
    "document",
    "verification"
  ],
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "@scanmate/ink": "^0.0.1",
    "@scanmate/ocr": "^0.0.1"
  },
  "publishConfig": {
